{
  "name": "testbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "check:demo": "node scripts/demo-check.mjs",
    "start:lan": "next build && next start -H 0.0.0.0 -p 3000",
    "db:reset": "node scripts/db-setup.mjs",
    "db:docker": "docker start testbridge-db || docker run -d --name testbridge-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=testbridge -p 54329:5432 postgres:16-alpine"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.49.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
