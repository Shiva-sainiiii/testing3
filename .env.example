# Leave DATABASE_URL empty to use the built-in local database (PGlite, stored in ./.data).
# Nothing to install. Data survives restarts. `npm run db:reset` wipes it.
DATABASE_URL=

# Optional: use a real Postgres server instead (Supabase "Transaction pooler" URI, or Docker):
# DATABASE_URL=postgres://postgres:postgres@localhost:54329/testbridge

# Optional, only with Supabase: instant updates via Realtime (otherwise screens refresh every 2s).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
